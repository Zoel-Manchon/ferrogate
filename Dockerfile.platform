FROM python:3.12-slim

RUN useradd --create-home --uid 10003 platform
WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .

# El script de enrolamiento viaja en la imagen para poder ejecutarlo
# dentro de la red de docker, sin depender del puerto 5432 del host.
COPY ops/seed.py ./ops/seed.py

USER platform
CMD ["python", "-u", "-m", "ferrogate.platform_api.main"]
