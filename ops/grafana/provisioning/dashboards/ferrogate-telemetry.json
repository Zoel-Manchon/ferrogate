    {
      "id": 13,
      "type": "table",
      "title": "Estado actual de cada tag",
      "description": "Ultimo valor recibido por tag, con su calidad. En el tenant con un sensor averiado, aqui se ve el tag congelado.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_TENANT}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "noValue": "sin lecturas"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "quality"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "good": {
                        "color": "#73BF69",
                        "index": 0,
                        "text": "GOOD"
