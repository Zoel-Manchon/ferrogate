{
  "uid": "ferrogate-telemetry",
  "title": "Ferrogate — Telemetria industrial multi-tenant",
  "description": "Modbus -> gateway edge (sobre firmado, mTLS) -> ingesta verificada -> InfluxDB. El selector 'Tenant' cambia de datasource: cada tenant tiene su propio bucket, asi que el aislamiento se mantiene tambien en la visualizacion.",
  "tags": [
    "ferrogate",
    "iot",
    "modbus",
    "multi-tenant"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "liveNow": false,
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "DS_TENANT",
        "label": "Tenant",
        "type": "datasource",
        "query": "influxdb",
        "current": {
          "text": "tenant-acme",
          "value": "tenant-acme"
        },
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Resumen del sitio",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Potencia total",
      "description": "Consumo agregado de las tres fases.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_TENANT}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 30000
              },
              {
                "color": "red",
                "value": 45000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> filter(fn: (r) => r.quality == \"good\")\n  |> filter(fn: (r) => r.tag_name == \"total_power\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"tag_name\"])",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_TENANT}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Frecuencia de red",
      "description": "Fuera de 49.5-50.5 Hz indica inestabilidad.",
